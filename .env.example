# Copy this file to .env and fill in values. .env is gitignored.
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# Used by the backend. Inside Docker the host is "db"; from your Mac it's "localhost".
DATABASE_URL=postgresql+psycopg://finance:change-me@db:5432/finance

# Where the browser finds the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used by pytest on your Mac. Must end in _test: the tests wipe this database.
TEST_DATABASE_URL=postgresql+psycopg://finance:change-me@localhost:5432/finance_test

# From dashboard.plaid.com > Developers > Keys. Sandbox and production have different secrets.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PROD=
# sandbox (fake banks) or production (your real banks).
PLAID_ENV=sandbox
# Encrypts Plaid access tokens in the database. Make one with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_KEY=

# Your timezone, for "today" in the backend (the server itself runs in UTC).
TIMEZONE=America/Toronto

# The Ask page's AI. Free key: aistudio.google.com > Get API key.
GEMINI_API_KEY=
# Free tier: flash-lite allows plenty; gemini-3.5-flash allows only 20 requests a day.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini's free tier may train on what it's sent, so Ask only answers on the demo database.
# Set to true only once you've switched to a provider you trust with your real finances.
AI_ALLOW_REAL_DATA=false
